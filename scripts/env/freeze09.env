# THE freeze-0.9 flag set — the single source of truth.
#
# Retyping this by hand has silently produced wrong-physics runs (a 46h
# 100M equilibration on engine DEFAULTS, 2026-09-02). Engine defaults are
# NOT freeze-0.9: HARDSHIP_MODE defaults to "cliff", INCOME_CALIBRATION to
# "off", MORTALITY_MODE to "legacy". A run without these exports is the
# OLD physics and its numbers are not comparable to any board.
#
# Usage:  set -a; . scripts/env/freeze09.env; set +a
export EARTH1_HARDSHIP_MODE=gradient
export EARTH1_INCOME_CALIBRATION=v1
export EARTH1_SUBSTRATE_FLAG=c2plus_v1
export EARTH1_C2PLUS_TABLES=c2plus_tables_v2.json
export EARTH1_MORTALITY_MODE=gompertz
export EARTH1_GM_OTHER_SHARE=0.21407724082954704
export EARTH1_WANT_MODE=rr
export EARTH1_WANT_RR=4.933765606879083
export EARTH1_WEATHER_SCALE=0.020333010074315046
export EARTH1_DISTRESS_LAYOFFS=on
export EARTH1_LAYOFF_GAIN=0.0028
