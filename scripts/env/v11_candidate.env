# v1.1 CANDIDATE flag set — freeze-0.9 base + the two founder-approved
# physics fixes (rulings 1-2, 2026-09-08). freeze-0.9 itself, its
# checkpoints and its published results remain the reproducible
# historical version; this file defines the CANDIDATE under evaluation
# per ops/alive/cycles/{URBAN_FIX_PREREG,REHOME_CLAMP_PREREG}.md.
# Usage:  set -a; . scripts/env/v11_candidate.env; set +a
export EARTH1_HARDSHIP_MODE=gradient
export EARTH1_INCOME_CALIBRATION=v1
export EARTH1_SUBSTRATE_FLAG=c2plus_v1
export EARTH1_C2PLUS_TABLES=c2plus_tables_v2.json
export EARTH1_MORTALITY_MODE=gompertz
export EARTH1_GM_OTHER_SHARE=0.21407724082954704
export EARTH1_WANT_MODE=rr
export EARTH1_WANT_RR=4.933765606879083
export EARTH1_WEATHER_SCALE=0.020333010074315046
export EARTH1_DISTRESS_LAYOFFS=on
export EARTH1_LAYOFF_GAIN=0.0028
# the two named changes under evaluation:
export EARTH1_URBAN_AXIS_FIX=on
export EARTH1_REHOME_LOCAL_CLAMP=1
