[
  {
    "name": "run8_fetcher",
    "pgrep": "[f]etch_headlines.py",
    "done_check": "test $(/opt/earth1/.venv/bin/python3 -c \"import json;print(len(json.load(open('/opt/earth1/data/headlines_2017_2022.json'))))\" 2>/dev/null || echo 0) -ge 480",
    "log": "/opt/earth1/fetch.log",
    "launch": "cd /opt/earth1 && GDELT_PACE=8 .venv/bin/python -u scripts/fetch_headlines.py > fetch.log 2>&1",
    "max_retries": 6
  },
  {
    "name": "run8_fire",
    "pgrep": "[g]5_run8_temporal|[p]erceive_headlines",
    "done_check": "test -f /opt/earth1/data/run8_fired",
    "requires": "test $(/opt/earth1/.venv/bin/python3 -c \"import json;print(len(json.load(open('/opt/earth1/data/headlines_2017_2022.json'))))\" 2>/dev/null || echo 0) -ge 480",
    "log": "/tmp/run8.log",
    "launch": "cd /opt/earth1 && export $(grep -v '^#' .env | xargs) && .venv/bin/python3 scripts/perceive_headlines.py && .venv/bin/python3 scripts/g5_run8_temporal.py && touch data/run8_fired",
    "max_retries": 2
  }
]