[
  {
    "name": "ab_arm_current",
    "pgrep": "[i]nheritance_ab_test.py current",
    "done_check": "test -f /opt/earth1/data/inheritance_ab_current.json",
    "log": "/tmp/ab_current.log",
    "launch": "cd /opt/earth1 && nohup .venv/bin/python3 scripts/inheritance_ab_test.py current > /tmp/ab_current.log 2>&1 &",
    "max_retries": 3
  },
  {
    "name": "ab_arm_entry",
    "pgrep": "[i]nheritance_ab_test.py entry",
    "done_check": "test -f /opt/earth1/data/inheritance_ab_entry.json",
    "log": "/tmp/ab_entry.log",
    "launch": "cd /opt/earth1 && nohup .venv/bin/python3 scripts/inheritance_ab_test.py entry > /tmp/ab_entry.log 2>&1 &",
    "max_retries": 3
  },
  {
    "name": "ab_merge",
    "pgrep": "[i]nheritance_ab_test.py merge",
    "done_check": "test -f /opt/earth1/data/inheritance_ab.json",
    "requires": "test -f /opt/earth1/data/inheritance_ab_current.json && test -f /opt/earth1/data/inheritance_ab_entry.json",
    "log": "/tmp/ab_merge.log",
    "launch": "cd /opt/earth1 && nohup .venv/bin/python3 scripts/inheritance_ab_test.py merge > /tmp/ab_merge.log 2>&1 &",
    "max_retries": 3
  },
  {
    "name": "rung_10m",
    "pgrep": "[r]ung_1m.py",
    "done_check": "test -f /opt/earth1/data/rung_10m.json",
    "log": "/opt/earth1/rung10m.log",
    "launch": "cd /opt/earth1 && RUNG_POP=10000000 RUNG_NAME=10m nohup .venv/bin/python3 scripts/rung_1m.py > rung10m.log 2>&1 &",
    "max_retries": 2
  }
]
